# 本地复制为 .env.local（已被 gitignore）。线上写在 EdgeOne 控制台的构建环境变量里，
# 构建期由 vite.config.ts 的 bake-secrets-for-ssr 烘焙进 SSR 包。

# --- 数据库（必填） ---
# 阿里云 PostgreSQL。留空或仍指向 neon 时，构建期会自动换成内置地址。
# 密码里的 $ @ ! # 必须 URL 编码（%24 %40 %21 %23），否则连接串解析会当场失败。
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=verify-full
# drizzle-kit 迁移用，直连端点；池化端点无法承载会话级状态。
DATABASE_URL_DIRECT=postgresql://user:password@host:5432/postgres?sslmode=verify-full
# 连接池上限，默认 5。云函数实例多时别调太高，PG 侧连接数是硬上限。
# PG_POOL_MAX=5

# --- 认证（必填） ---
# 至少 32 字符，改动会让所有已登录会话失效。
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# 必须是完整地址，带协议、不带尾斜杠。
BETTER_AUTH_URL=http://localhost:3000
# 站点域名，用于 cookie 与 canonical。
DOMAIN=blog.example.com

# --- 登录（必填，这是唯一的登录方式） ---
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# --- umami 访问统计（可选，不填就是没有统计） ---
# 前端埋点脚本的 data-website-id。这个是开关：不填，页面里不会有 <script>。
# 走 Vite 原生注入，属于构建期变量，改完必须重新构建。
# VITE_UMAMI_WEBSITE_ID=your-umami-website-id
# umami 站点根地址，带协议、不带尾斜杠。/stats.js 与 /api/send 都靠它反代。
# UMAMI_SRC=https://umami.example.com
# 服务端查文章热度用，值要跟上面的 website id 相同。
# UMAMI_WEBSITE_ID=your-umami-website-id
# 自托管走账号密码换取 token，不需要 API key。
# UMAMI_USERNAME=admin
# UMAMI_PASSWORD=your-password
# API 地址默认推成 ${UMAMI_SRC}/api，只有反代到别的路径才需要显式指定。
# UMAMI_API_URL=https://umami.example.com/api

# --- 只在 EdgeOne 之外（本地 Node）需要 ---
# 线上由平台自行鉴权，不用填。
# EO_BLOB_PROJECT_ID=your-edgeone-project-id
# EO_BLOB_TOKEN=your-edgeone-blob-token
