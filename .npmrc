# The EdgeOne builder installs with npm, which hard-fails on the peer range
# `@edgeone/tanstack-start` declares (vite ^5 || ^6 || ^7). The adapter is only a
# closeBundle hook that reads dist/server/server.js, and it runs correctly on
# Vite 8 — verified locally with a real build and a served site. Keeping Vite 8
# is what lets the project stay on TanStack Start 1.169's route `server:` API,
# which 1.168 (the last version pinned to Vite 7) does not have.
legacy-peer-deps=true
